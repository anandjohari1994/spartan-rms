APP_NAME="Spartan RMS"
APP_TIMEZONE=Asia/Kolkata
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Careers: Round 2, Round 3, custom messages and all other application emails.
# Set each account's MAILER to smtp after entering its SMTP credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME="careers@spartaninfosoft.com"
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="careers@spartaninfosoft.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional company To mailbox for candidate BCC emails; blank uses the selected sender.
MAIL_TO_ADDRESS=

# Round 1 (all Round 1 email templates).
INVITATION_MAIL_MAILER=log
INVITATION_MAIL_SCHEME=null
INVITATION_MAIL_HOST=127.0.0.1
INVITATION_MAIL_PORT=2525
INVITATION_MAIL_USERNAME="invitation@spartaninfosoft.com"
INVITATION_MAIL_PASSWORD=null
INVITATION_MAIL_FROM_ADDRESS="invitation@spartaninfosoft.com"
INVITATION_MAIL_FROM_NAME="${APP_NAME}"

# Offer letters.
HR_MAIL_MAILER=log
HR_MAIL_SCHEME=null
HR_MAIL_HOST=127.0.0.1
HR_MAIL_PORT=2525
HR_MAIL_USERNAME="hr@spartaninfosoft.com"
HR_MAIL_PASSWORD=null
HR_MAIL_FROM_ADDRESS="hr@spartaninfosoft.com"
HR_MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
